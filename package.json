{
  "name": "front-end-portfolio",
  "version": "0.1.0",
  "homepage": "https://boostertech.github.io/Software_Engineer_Portfolio/",
  "private": true,
  "dependencies": {
    "framer-motion": "12.43.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "5.0.1",
    "react-scripts": "5.0.1",
    "react-scroll": "1.9.0",
    "styled-components": "6.1.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject",
    "predeploy": "npm run build && node scripts/remove-maps.js",
    "deploy": "gh-pages -d build",
    "size-check": "node scripts/check-file-size.js",
    "lint": "eslint src",
    "format:check": "prettier --check src",
    "bundle:check": "node scripts/bundle-size.js",
    "check:colors": "node scripts/check-hardcoded-colors.js",
    "check:circular": "node scripts/check-circular.js",
    "lighthouse:check": "cross-env PUBLIC_URL=. npm run build && lhci autorun",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "e2e/**/*.spec.js"
        ],
        "rules": {
          "testing-library/prefer-screen-queries": "off"
        }
      }
    ]
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "13.4.0",
    "cross-env": "10.1.0",
    "gh-pages": "6.1.1",
    "madge": "8.0.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  }
}
